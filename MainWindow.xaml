<Window x:Class="AppMixer.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Volume Mixer"
        Icon="pack://application:,,,/app.ico"
        Width="360" Height="640" MinWidth="300" MinHeight="320"
        Background="{StaticResource BgBrush}"
        Foreground="{StaticResource TextBrush}"
        FontFamily="Segoe UI" FontSize="13"
        UseLayoutRounding="True"
        TextOptions.TextFormattingMode="Display">

    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="44" ResizeBorderThickness="6" GlassFrameThickness="0"
                      CornerRadius="0" UseAeroCaptionButtons="False"/>
    </WindowChrome.WindowChrome>

    <Border x:Name="Root" BorderBrush="#3A3A3A" BorderThickness="1">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="44"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- Title bar (drag anywhere here to move the window) -->
            <Grid Grid.Row="0" Margin="14,0,6,0">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="&#xE767;" FontFamily="{StaticResource Glyphs}" FontSize="14"
                               VerticalAlignment="Center" Margin="0,0,10,0"/>
                    <TextBlock Text="Volume Mixer" FontSize="14" FontWeight="SemiBold" VerticalAlignment="Center"/>
                </StackPanel>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                    <ToggleButton Style="{StaticResource PinToggle}" WindowChrome.IsHitTestVisibleInChrome="True"
                                  IsChecked="{Binding Topmost, RelativeSource={RelativeSource AncestorType=Window}}"/>
                    <Button Style="{StaticResource IconButton}" WindowChrome.IsHitTestVisibleInChrome="True"
                            Content="&#xE921;" FontSize="10" ToolTip="Minimize" Click="Minimize_Click"/>
                    <Button Style="{StaticResource CloseButton}" WindowChrome.IsHitTestVisibleInChrome="True"
                            Content="&#xE8BB;" ToolTip="Close to tray" Click="Close_Click"/>
                </StackPanel>
            </Grid>

            <!-- Output device + master volume -->
            <StackPanel Grid.Row="1" Margin="16,4,16,0">
                <TextBlock Text="Output" FontWeight="SemiBold" FontSize="13" Margin="0,0,0,8"/>
                <ComboBox Style="{StaticResource DarkCombo}"
                          ItemsSource="{Binding Devices}" SelectedItem="{Binding SelectedDevice}">
                    <ComboBox.ItemTemplate>
                        <DataTemplate>
                            <DockPanel>
                                <TextBlock DockPanel.Dock="Right" Text="Default" FontSize="11" Margin="10,0,0,0"
                                           Foreground="{StaticResource SubTextBrush}" VerticalAlignment="Center"
                                           Visibility="{Binding IsDefault, Converter={StaticResource BoolToVis}}"/>
                                <TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/>
                            </DockPanel>
                        </DataTemplate>
                    </ComboBox.ItemTemplate>
                </ComboBox>

                <Grid Margin="0,10,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="36"/>
                    </Grid.ColumnDefinitions>
                    <Button Style="{StaticResource IconButton}" Content="{Binding MasterGlyph}"
                            Command="{Binding ToggleMasterMuteCommand}" ToolTip="Mute / unmute device"
                            Margin="-6,0,4,0"/>
                    <Grid Grid.Column="1" VerticalAlignment="Center">
                        <Slider Style="{StaticResource MixSlider}" Value="{Binding MasterVolume}"/>
                        <!-- live level -->
                        <Grid Height="2" VerticalAlignment="Bottom" Margin="1,0,1,-2" IsHitTestVisible="False">
                            <Border Background="#303030" CornerRadius="1"/>
                            <Border Background="{DynamicResource AccentBrush}" CornerRadius="1" Opacity="0.7"
                                    RenderTransformOrigin="0,0.5">
                                <Border.RenderTransform>
                                    <ScaleTransform ScaleX="{Binding MasterPeak}"/>
                                </Border.RenderTransform>
                            </Border>
                        </Grid>
                    </Grid>
                    <TextBlock Grid.Column="2" Text="{Binding MasterVolume, StringFormat={}{0:0}}"
                               HorizontalAlignment="Right" VerticalAlignment="Center"
                               Foreground="{StaticResource SubTextBrush}"/>
                </Grid>

                <Border Height="1" Background="{StaticResource LineBrush}" Margin="0,14,0,12"/>
            </StackPanel>

            <!-- Apps header -->
            <Grid Grid.Row="2" Margin="16,0,16,10">
                <TextBlock Text="Apps" FontWeight="SemiBold" VerticalAlignment="Center"/>
                <ToggleButton Style="{StaticResource PillToggle}" HorizontalAlignment="Right"
                              Content="Playing only" IsChecked="{Binding PlayingOnly}"
                              ToolTip="Hide apps that haven't made sound in the last 10 seconds"/>
            </Grid>

            <!-- App list -->
            <Grid Grid.Row="3">
                <TextBlock Text="{Binding EmptyMessage}" Foreground="{StaticResource SubTextBrush}"
                           HorizontalAlignment="Center" VerticalAlignment="Top" Margin="16,24,16,0"
                           TextWrapping="Wrap" TextAlignment="Center"
                           Visibility="{Binding HasNoVisibleApps, Converter={StaticResource BoolToVis}}"/>

                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                              Padding="12,0,8,8">
                    <ItemsControl ItemsSource="{Binding Apps}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Background="{StaticResource PanelBrush}" CornerRadius="8"
                                        Padding="10,10,12,10" Margin="0,0,0,8"
                                        Visibility="{Binding IsVisible, Converter={StaticResource BoolToVis}}">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>

                                        <!-- App icon -->
                                        <Border Width="40" Height="40" CornerRadius="8" Background="#333333"
                                                VerticalAlignment="Top" Margin="0,2,12,0">
                                            <Grid>
                                                <Image Source="{Binding Icon}" Width="28" Height="28"
                                                       RenderOptions.BitmapScalingMode="HighQuality"/>
                                                <TextBlock Text="{Binding FallbackGlyph}" FontFamily="{StaticResource Glyphs}"
                                                           FontSize="18" HorizontalAlignment="Center" VerticalAlignment="Center">
                                                    <TextBlock.Style>
                                                        <Style TargetType="TextBlock">
                                                            <Setter Property="Visibility" Value="Collapsed"/>
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding Icon}" Value="{x:Null}">
                                                                    <Setter Property="Visibility" Value="Visible"/>
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </TextBlock.Style>
                                                </TextBlock>
                                            </Grid>
                                        </Border>

                                        <StackPanel Grid.Column="1">
                                            <!-- Name + "playing" dot + mute -->
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Text="{Binding Name}" ToolTip="{Binding Name}"
                                                           TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/>
                                                <Ellipse Grid.Column="1" Width="6" Height="6" Margin="8,1,6,0"
                                                         VerticalAlignment="Center"
                                                         Fill="{DynamicResource AccentBrush}" ToolTip="Playing sound"
                                                         Visibility="{Binding IsAudible, Converter={StaticResource BoolToVis}}"/>
                                                <Button Grid.Column="2" Style="{StaticResource IconButton}"
                                                        Content="{Binding VolumeGlyph}" Command="{Binding ToggleMuteCommand}"
                                                        ToolTip="Mute / unmute" Margin="0,-4,-6,-4"/>
                                            </Grid>

                                            <!-- Volume slider + number -->
                                            <Grid Margin="0,2,0,0">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="32"/>
                                                </Grid.ColumnDefinitions>
                                                <Grid>
                                                    <Grid.Style>
                                                        <Style TargetType="Grid">
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding Muted}" Value="True">
                                                                    <Setter Property="Opacity" Value="0.45"/>
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </Grid.Style>
                                                    <Slider Style="{StaticResource MixSlider}" Value="{Binding Volume}"/>
                                                    <Grid Height="2" VerticalAlignment="Bottom" Margin="1,0,1,-3" IsHitTestVisible="False">
                                                        <Border Background="#383838" CornerRadius="1"/>
                                                        <Border Background="{DynamicResource AccentBrush}" CornerRadius="1" Opacity="0.7"
                                                                RenderTransformOrigin="0,0.5">
                                                            <Border.RenderTransform>
                                                                <ScaleTransform ScaleX="{Binding Peak}"/>
                                                            </Border.RenderTransform>
                                                        </Border>
                                                    </Grid>
                                                </Grid>
                                                <TextBlock Grid.Column="1" Text="{Binding Volume, StringFormat={}{0:0}}"
                                                           HorizontalAlignment="Right" VerticalAlignment="Center"
                                                           Foreground="{StaticResource SubTextBrush}"/>
                                            </Grid>
                                        </StackPanel>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </Grid>
        </Grid>
    </Border>
</Window>
